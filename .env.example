# FootballMind environment -- copy to .env and fill in. Never commit .env.

# Neon Postgres. Use the POOLED connection string (the host containing
# "-pooler") and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# football-data.org API key (free tier: 10 requests/minute) -- sync job only.
FOOTBALL_DATA_API_KEY=

# API-Football / api-sports.io key (optional, free tier: 100 req/day).
# Used for PL+ league injuries (non-PL) and per-match player ratings.
API_FOOTBALL_KEY=

# Footballdata.io key (optional) — club squad positions when FOOTBALLDATA_IO_SYNC_ROLES=1
FOOTBALLDATA_IO_KEY=

# Wikipedia squad sync (free, no API key) — runs during sync-enrich by default.
# Set WIKIPEDIA_SYNC=0 to disable.
WIKIPEDIA_SYNC=

# CORS origin for the Flask API
FRONTEND_ORIGIN=https://YOUR_GITHUB_USERNAME.github.io

# Claude API key for the free-form chat path (LiteLLM gateway) -- not needed
# until that layer is wired in.
ANTHROPIC_API_KEY=

# Remote MCP (streamable-http at /mcp on Render). Set the same value in
# Render env vars and in ~/.cursor/mcp.json for footballmind-remote.
MCP_API_KEY=

# Admin API for manual injury/doubt flags (POST/DELETE /api/admin/availability).
# Falls back to MCP_API_KEY if unset. Enable UI via ?admin_key=YOUR_KEY once.
FOOTBALLMIND_ADMIN_KEY=
